# === Required secrets (app will not start without these) ===
AZURE_DI_ENDPOINT=https://your-azure-di.cognitiveservices.azure.com
AZURE_DI_KEY=your-azure-di-api-key
OPENAI_API_KEY=sk-your-openai-key
COHERE_API_KEY=your-cohere-key
LOGFIRE_TOKEN=your-logfire-token
HUGGINGFACE_TOKEN=hf_your-token

# === Sidecar URLs (defaults work with docker-compose) ===
BIFROST_URL=http://bifrost:8080
LOGFIRE_PROJECT_URL=your-logfire-project-url
LLM_GUARD_URL=http://llm-guard:8000
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# === Sidecar URLs (for running locally) ===
# BIFROST_URL=http://localhost:8081
# LLM_GUARD_URL=http://localhost:8001
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0

# === Models ===
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODEL=rerank-english-v3.0
LLM_MODEL=openai/gpt-5.4
LLM_PROVIDER=meshapi
SPARSE_MODEL=naver/splade-v3

# === Retrieval tuning ===
RRF_K=60
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_N_RERANK=5

# === Strategy switches ===
CHUNKER_STRATEGY=document_aware
SPARSE_ENABLED=true
LLM_GUARD_OUTPUT_ENABLED=false

# === Chunking ===
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP=50

# === Cache TTLs (seconds) ===
CACHE_TTL_EMBED=86400
CACHE_TTL_RERANK=21600
CACHE_TTL_ANSWER=3600

# === Qdrant ===
QDRANT_COLLECTION=documents
